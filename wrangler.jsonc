{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chanchimercado",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chanchimercado",
      "database_id": "eaa2f521-ddfe-4a51-a54c-61da0ba80aa2",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "55df952af1a5410dbad4dad436f550c2"
    }
  ],
  "vars": {
    "APP_NAME": "ChanchiMercado"
  }
}
