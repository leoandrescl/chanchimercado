{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chanchimercado",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chanchimercado",
      "database_id": "eaa2f521-ddfe-4a51-a54c-61da0ba80aa2",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "55df952af1a5410dbad4dad436f550c2"
    },
    {
      "binding": "BACKUPS",
      "id": "36539d20d01f4ef5845330c6d15647e4"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "vars": {
    "APP_NAME": "ChanchiMercado"
  }
}
